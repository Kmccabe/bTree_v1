## Server-only envs (Vercel Functions)
# Set these in Vercel Project Settings → Environment Variables
TESTNET_ALGOD_URL=https://testnet-api.algonode.cloud
TESTNET_ALGOD_TOKEN=

## Client envs (exposed to the browser via Vite)
VITE_NETWORK=TESTNET
VITE_TESTNET_ALGOD_URL=https://testnet-api.algonode.cloud
VITE_TESTNET_INDEXER_URL=https://testnet-idx.algonode.cloud
VITE_TESTNET_ALGOD_TOKEN=

# --- LocalNet (SDK/CI only; not used by Pera) ---
VITE_LOCALNET_ALGOD_URL=http://localhost:4001
VITE_LOCALNET_INDEXER_URL=http://localhost:8980
VITE_LOCALNET_ALGOD_TOKEN=a"localnet-token-if-needed"

# Streaming mode for admin compile logs: 'chunk' (default) or 'sse'
VITE_COMPILE_STREAM_MODE=chunk

# Dev-only mock controls (optional)
# VITE_DEV_MOCK_COMPILE=1
# VITE_DEV_MOCK_LINES=200
# VITE_DEV_MOCK_DELAY_MS=250
