{
  "name": "trust-game-frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev:vite": "vite",
    "dev:api": "vercel dev .. --yes --listen 3000",
    "dev": "npm-run-all -p dev:api dev:vite",
    "typecheck": "tsc -b --pretty false",
    "preflight": "npm run typecheck && vite build",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@perawallet/connect": "^1.4.2",
    "@txnlab/use-wallet": "^2.0.0",
    "algosdk": "^3.4.0",
    "buffer": "^6.0.3",
    "process": "^0.11.10",
    "qrcode": "^1.5.3",
    "qrcode.react": "^3.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.30.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.3.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vercel/node": "^3.0.0",
    "@vitejs/plugin-react": "^5.0.2",
    "dotenv": "^17.2.2",
    "jsdom": "^27.1.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.4.0",
    "vercel": "^48.1.0",
    "vite": "^5.0.0",
    "vitest": "^4.0.8"
  },
  "engines": {
    "node": "22.x"
  }
}
